# Campus-Cram Environment Variables
# Copy this file to .env and configure your keys

# Google Gemini API Key for CBT Exam, Theory Evaluation, OCR, Socratic Tutor, and Cram Sheets
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Disable dependency validation warnings in Expo if using custom packages
EXPO_NO_DEPENDENCY_VALIDATION=1
